{
  "manifest_version": 3,
  "name": "YouTube Focus Filter – Study Clean Feed",
  "version": "0.1.1",
  "description": "Keep YouTube on-topic while studying. Strict allowlist filter for Home / Search / Sidebar + full Shorts removal. 100% local, no AI.",
  "homepage_url": "https://github.com/Perpetual-Code/yt-focus-lens",
  "permissions": ["storage", "tabs", "sidePanel", "history", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Focus Filter – click to open sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
